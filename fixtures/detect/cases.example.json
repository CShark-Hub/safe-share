    {"id": "neg_password_prose_q", "lines": ["Forgot your password? Reset it here"], "expect": []},
    {"id": "neg_password_empty", "lines": ["  \"password\": \"\","], "expect": []},
    {"id": "neg_url_query", "lines": ["https://example.com/search?q=token+rotation&page=2"], "expect": []},
    {"id": "neg_url_port", "lines": ["http://localhost:8080/api/v1/health"], "expect": []},
    {"id": "neg_conn_no_password", "lines": ["postgres://db.internal:5432/app"], "expect": []},
    {"id": "neg_java_import", "lines": ["import org.springframework.boot.autoconfigure.SpringBootApplication;"], "expect": []},
    {"id": "neg_data_uri", "lines": ["src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAAB\""], "expect": []},
    {"id": "neg_log_level", "lines": ["LOG_LEVEL: debug"], "expect": []},
    {"id": "neg_feature_token_true", "lines": ["feature_flags_token: true"], "expect": []},
    {"id": "neg_sha256", "lines": ["sha256:9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08"], "expect": []},
    {"id": "neg_semver", "lines": ["version 1.24.3-beta.2 released"], "expect": []}
  ]
}
